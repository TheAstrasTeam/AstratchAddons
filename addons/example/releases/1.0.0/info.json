{
  "id": "example",
  "name": "Example Addon",
  "version": "1.0.0",
  "author": "AstrasTeam",
  "description": "A sample addon that shows a notification when enabled.",
  "license": "MIT",
  "icon": "assets/icon.svg",
  "main": "main.tsx",
  "typescript": true,
  "astratch": {
    "minVersion": "0.1.0",
    "settings": [
      {
        "name": "greeting name",
        "id": "name",
        "type": "string",
        "default": "world"
      },
      {
        "name": "volume",
        "id": "volume",
        "type": "number",
        "default": 50,
        "min": 0,
        "max": 100
      },
      {
        "name": "notify on disable",
        "id": "notifyOnDisable",
        "type": "boolean",
        "default": true
      },
      {
        "name": "multiline note",
        "id": "note",
        "type": "string",
        "default": "hello\nworld",
        "allowLines": true
      }
    ]
  }
}
